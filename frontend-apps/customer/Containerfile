# =============================================================================
# ACME Customer Frontend Container
# =============================================================================
# Multi-stage build for optimized container size
# - Stage 1: Install dependencies
# - Stage 2: Build the application
# - Stage 3: Create slim runtime image
# =============================================================================

# -----------------------------------------------------------------------------
# Stage 1: Dependencies
# -----------------------------------------------------------------------------
FROM node:24-alpine AS deps

WORKDIR /app

# Update npm to match local development version (prevents lock file mismatches)
RUN npm install -g npm@latest

# Copy package files
COPY package.json package-lock.json ./

# Install dependencies
RUN npm ci --ignore-scripts

# -----------------------------------------------------------------------------
# Stage 2: Build
# -----------------------------------------------------------------------------
FROM node:24-alpine AS builder

WORKDIR /app

# Copy dependencies from deps stage
COPY --from=deps /app/node_modules ./node_modules

# Copy source files
COPY . .

# Browser-facing backend URLs are baked in at build time (see src/services/api.ts).
# Empty values fall back to the localhost defaults in api.ts.
ARG VITE_IDENTITY_SERVICE_URL=""
ARG VITE_CUSTOMER_SERVICE_URL=""
ARG VITE_PRODUCT_SERVICE_URL=""
ARG VITE_INVENTORY_SERVICE_URL=""
ARG VITE_PRICING_SERVICE_URL=""
ENV VITE_IDENTITY_SERVICE_URL=$VITE_IDENTITY_SERVICE_URL \
    VITE_CUSTOMER_SERVICE_URL=$VITE_CUSTOMER_SERVICE_URL \
    VITE_PRODUCT_SERVICE_URL=$VITE_PRODUCT_SERVICE_URL \
    VITE_INVENTORY_SERVICE_URL=$VITE_INVENTORY_SERVICE_URL \
    VITE_PRICING_SERVICE_URL=$VITE_PRICING_SERVICE_URL

# Build the application
RUN npm run build

# -----------------------------------------------------------------------------
# Stage 3: Runtime
# -----------------------------------------------------------------------------
FROM node:24-alpine AS runner

LABEL org.opencontainers.image.title="ACME Customer Frontend"
LABEL org.opencontainers.image.description="Customer-facing web application for ACME Inc. e-commerce platform"
LABEL org.opencontainers.image.vendor="ACME Inc."
LABEL org.opencontainers.image.source="https://github.com/cebartling/acme-inc-2026"

# Create non-root user for security
RUN addgroup --system --gid 1001 acme \
    && adduser --system --uid 1001 --ingroup acme acme

WORKDIR /app

# Copy built application from builder stage
COPY --from=builder --chown=acme:acme /app/.output ./.output
COPY --from=builder --chown=acme:acme /app/package.json ./package.json

# Switch to non-root user
USER acme

# Expose the application port
EXPOSE 3000

# Environment variables
ENV NODE_ENV=production
ENV HOST=0.0.0.0
ENV PORT=3000
ENV NITRO_PORT=3000
ENV NITRO_HOST=0.0.0.0

# Run the Nitro server
CMD ["node", ".output/server/index.mjs"]
