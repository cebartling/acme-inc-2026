# Left running, the demo environment costs far more than the foundation does,
# so this catches a demo environment that wasn't destroyed.
resource "aws_budgets_budget" "monthly" {
  name         = "acme-demo-monthly"
  budget_type  = "COST"
  limit_amount = tostring(var.budget_limit_usd)
  limit_unit   = "USD"
  time_unit    = "MONTHLY"

  notification {
    comparison_operator        = "GREATER_THAN"
    threshold                  = 100
    threshold_type             = "PERCENTAGE"
    notification_type          = "ACTUAL"
    subscriber_email_addresses = [var.budget_alert_email]
  }
}
