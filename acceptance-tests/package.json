{
  "name": "acme-acceptance-tests",
  "version": "1.0.0",
  "description": "Acceptance testing framework for ACME Inc. e-commerce platform",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "bun ./node_modules/@cucumber/cucumber/bin/cucumber.js --import 'support/world.ts' --import 'support/hooks.ts' --import 'steps/**/*.ts' --tags 'not @rate-limiting' --tags 'not @wip'",
    "test:smoke": "bun ./node_modules/@cucumber/cucumber/bin/cucumber.js --import 'support/world.ts' --import 'support/hooks.ts' --import 'steps/**/*.ts' --tags '@smoke and not @wip'",
    "test:regression": "bun ./node_modules/@cucumber/cucumber/bin/cucumber.js --import 'support/world.ts' --import 'support/hooks.ts' --import 'steps/**/*.ts' --tags '@regression and not @wip'",
    "test:customer": "bun ./node_modules/@cucumber/cucumber/bin/cucumber.js --import 'support/world.ts' --import 'support/hooks.ts' --import 'steps/**/*.ts' --tags '@customer and not @wip'",
    "test:admin": "bun ./node_modules/@cucumber/cucumber/bin/cucumber.js --import 'support/world.ts' --import 'support/hooks.ts' --import 'steps/**/*.ts' --tags '@admin and not @wip'",
    "test:logout": "bun ./node_modules/@cucumber/cucumber/bin/cucumber.js --import 'support/world.ts' --import 'support/hooks.ts' --import 'steps/**/*.ts' --tags '@logout and not @wip'",
    "test:headed": "HEADED=true bun ./node_modules/@cucumber/cucumber/bin/cucumber.js --import 'support/world.ts' --import 'support/hooks.ts' --import 'steps/**/*.ts' --tags 'not @rate-limiting' --tags 'not @wip'",
    "lint": "bun x eslint .",
    "lint:fix": "bun x eslint . --fix",
    "format": "bun x prettier --write \"**/*.ts\"",
    "format:check": "bun x prettier --check \"**/*.ts\"",
    "typecheck": "bun x tsc --noEmit"
  },
  "keywords": [
    "acceptance-testing",
    "cucumber",
    "playwright",
    "bdd",
    "e2e"
  ],
  "author": "ACME Inc.",
  "license": "UNLICENSED",
  "devDependencies": {
    "@cucumber/cucumber": "^13.2.1",
    "@cucumber/messages": "^34.2.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.6",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "otplib": "^13.5.0",
    "prettier": "^3.9.8",
    "typescript": "^6.0.3"
  },
  "engines": {
    "bun": ">=1.2.0"
  }
}
